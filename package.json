{
  "name": "puppet3dwebapp",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b && vite build",
    "lint": "npm run lint:webapp && npm run lint:electron",
    "lint:webapp": "eslint . --config eslint.config.mjs",
    "lint:electron": "eslint electron --config eslint.electron.config.mjs",
    "format": "npx prettier src --write",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "echo 'there is no test'",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:puppet3d/puppet3dwebapp.git"
  },
  "author": "GyeonghoKim",
  "license": "GPL-3.0",
  "homepage": "https://github.com/puppet3d/puppet3dwebapp",
  "dependencies": {
    "@pixiv/three-vrm": "^3.4.2",
    "@react-three/drei": "^10.6.0",
    "@react-three/fiber": "^9.2.0",
    "@tailwindcss/vite": "^4.1.11",
    "electron-squirrel-startup": "^1.0.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "tailwindcss": "^4.1.11",
    "three": "^0.178.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.8.3",
    "@electron-forge/maker-rpm": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.3",
    "@electron-forge/plugin-fuses": "^7.8.3",
    "@electron-forge/plugin-vite": "^7.8.3",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.31.0",
    "@react-three/test-renderer": "^9.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.178.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "electron": "37.4.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --cache --fix",
    "*.{css,scss,json,md,mdx,yml,yaml,html}": "prettier --write"
  }
}
